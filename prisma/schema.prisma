generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique // optional username for login
  name         String
  passwordHash String?   // bcrypt hash; null for OAuth-only users
  avatarUrl    String?
  plan         String    @default("free") // free, pro, enterprise
  aiCredits    Int       @default(100)
  provider     String    @default("credentials") // credentials, google
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  assets       Asset[]

  @@index([email])
  @@index([username])
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  prompt      String?
  thumbnail   String?
  status      String      @default("draft") // draft, published, archived
  framework   String      @default("nextjs")
  theme       String      @default("light")
  industry    String?
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages       Page[]
  versions    Version[]
  components  Component[]
  deployments Deployment[]
}

model Page {
  id        String   @id @default(cuid())
  name      String
  route     String   @default("/")
  html      String?
  css       String?
  js        String?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Version {
  id        String   @id @default(cuid())
  name      String   @default("Untitled Version")
  snapshot  String
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Component {
  id        String   @id @default(cuid())
  name      String
  type      String
  category  String
  html      String
  css       String
  js        String?
  props     String?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id        String   @id @default(cuid())
  name      String
  type      String
  url       String
  size      Int?
  metadata  String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deployment {
  id        String   @id @default(cuid())
  url       String?
  platform  String   @default("vercel") // vercel, netlify, custom
  status    String   @default("pending") // pending, deployed, failed
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  thumbnail   String?
  html        String
  css         String
  js          String?
  isPremium   Boolean  @default(false)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
}
