# ─── Database (SQLite local file) ──────────────────────────────────────────
# Path must start with "file:" and point to a writable location on disk.
DATABASE_URL=file:./db/custom.db

# ─── NextAuth Configuration ────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string

# Set this to your public URL when running behind a reverse proxy.
# Examples:
#   NEXTAUTH_URL=https://your-domain.com
#   NEXTAUTH_URL=http://localhost:3000      (for local dev)
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth Credentials (optional) ───────────────────────────────────
# Get these from https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs to register in Google Console:
#   https://your-domain.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Z.AI / GLM API (optional — enables AI features) ───────────────────────
# Set these to enable AI page generation, image generation, and editor
# suggestions. Without these, the app still runs but AI features return
# friendly "AI not configured" errors.
#
# Get your API key from https://z.ai/
# Default base URL is https://api.z.ai/api/paas/v4 if ZAI_BASE_URL is unset.
#ZAI_API_KEY=
#ZAI_BASE_URL=https://api.z.ai/api/paas/v4
